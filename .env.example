# Copy to .env and fill in. Never commit .env.

# Server (use HOST=0.0.0.0 in containers; Render sets PORT itself)
HOST=127.0.0.1
PORT=8080

# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=audit_app

# Redis (host:port)
REDIS_HOST=localhost:6379
REDIS_PASSWORD=

SALES_AUDIT_PROGRAM=guvi
ACCOUNTS_EMAIL=accounts@example.com

# Leave SMTP_HOST empty to log mails without sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Zoho Creator learner import, every 15 minutes (fails with an error when the key is empty).
# It fetches the last ZOHO_SYNC_LOOKBACK_DAYS days; set ZOHO_API_FROM and ZOHO_API_TO (DD-Mon-YYYY)
# together to fetch a fixed window instead.
ZOHO_API_URL=https://www.zohoapis.in/creator/custom/teamzen_guvi/Zen_Learner_Data
ZOHO_API_PUBLIC_KEY=
ZOHO_SYNC_LOOKBACK_DAYS=3
ZOHO_API_FROM=
ZOHO_API_TO=

# Dashboard summaries (auditor TL and BDM): any OpenAI-compatible chat completions API.
# LLM_API_URL is the base URL (e.g. https://api.openai.com/v1); /chat/completions is added to it.
# LLM_API_KEY is sent as "Authorization: Bearer <key>" (leave empty for a local server that needs none).
# Leave LLM_API_URL or LLM_MODEL empty to turn the summaries off.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
